# Copy to .env and fill in what you use. .env is gitignored and only the
# server reads it; credentials never reach the browser.

# Which source to show at startup: mock | azure | github.
# Falls back to mock (with a warning) if that source has no credentials.
PROVIDER=mock

# Port for the server (WebSocket, health check, and the built app).
PORT=8787

# --- GitHub -----------------------------------------------------------------
# Fine-grained token with read access to: Metadata, Contents, Pull requests,
# Actions (and Commit statuses for check results). A classic token with `repo`
# also works.
GITHUB_TOKEN=
# A user or organisation whose repositories to list...
GITHUB_OWNER=
# ...and/or explicit repositories, comma separated.
GITHUB_REPOS=
# GitHub Enterprise Server: https://<host>/api/v3
# GITHUB_API_URL=https://api.github.com

# --- Azure DevOps -----------------------------------------------------------
# Personal access token with Code (Read) and Build (Read).
AZURE_DEVOPS_ORG=
# One or more projects, comma separated.
AZURE_DEVOPS_PROJECTS=
AZURE_DEVOPS_PAT=
# Azure DevOps Server: set this to the server root (e.g. https://ado.example.com/tfs)
# and AZURE_DEVOPS_ORG to the collection name.
# AZURE_DEVOPS_URL=https://dev.azure.com
