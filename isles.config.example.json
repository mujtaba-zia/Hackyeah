{
  "watch": ["payments", "Contoso/catalog", "gh:octo-org/web-app"],
  "coverage": {
    "Platform Integration": ["catalog", "payments"]
  },
  "thresholds": {
    "staleDays": 7,
    "waitingHours": 24,
    "crowdSize": 5,
    "draftPileup": 5,
    "failStreakHot": 3,
    "releaseStaleDays": 14
  },
  "rules": {
    "pipelineFailing": true,
    "sharedOutage": true,
    "reviewCrowd": true,
    "draftPileup": true,
    "stalePrs": true,
    "staleRelease": true,
    "meltdown": true
  },
  "pollSeconds": 60,
  "maxRepos": 12,
  "maxPrsPerRepo": 40
}
